# SlideForge PRO Environment Configuration

# 1. fal.ai API Key (1호 프로젝트 HookThumb에서 사용하신 키 그대로 사용)
FAL_KEY=

# 2. PayPal Live Client ID (1호 프로젝트에서 사용하신 Client ID 또는 본인 PayPal ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb

# 3. 로컬 테스트용 Ollama 호스트 및 모델 (기본값)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
